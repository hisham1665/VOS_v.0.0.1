# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored -- NEVER commit real credentials.
# All values here are placeholders.

# Groq API key (used by the default capability pool: web_search, summarization,
# vision, synthesis).
GROQ_API_KEY=

# Legacy Hugging Face token key. New code prefers HF_TOKEN (below); HUG is kept
# as a fallback for existing setups. Either way: NEVER commit a real token.
# HUG=

# Hugging Face Inference Providers token (used only by providers/hf.py).
# Create one at https://huggingface.co/settings/tokens and enable
# "Make calls to Inference Providers".
# The manual smoke test (`python smoke_hf_provider.py`) requires this variable.
HF_TOKEN=

# Inference Providers routing: "auto" lets Hugging Face pick a provider, or
# name one explicitly (e.g. together, nebius, groq).
HF_PROVIDER=auto

# Default Hugging Face model id (optional). When empty, providers.hf falls back
# to its DEFAULT_HF_MODEL.
HF_MODEL=

# Optional exam OCR model overrides. The YAML `models.ocr` profile remains the
# source of truth for Ollama's endpoint; these variables are useful for a quick
# local model swap without editing configuration.
# AOS_OLLAMA_OCR_MODEL=deepseek-ocr:3b
# AOS_HF_OCR_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# Optional OpenAI-compatible provider. Only needed when aos.yaml selects it.
OPENAI_API_KEY=

# Optional: set to a YAML profile outside this repository.
# AOS_CONFIG=/absolute/path/to/aos.yaml

# Memory is enabled by default for the general AOS workflow. Set to off to
# disable request/session reuse without editing aos.yaml.
AOS_MEMORY=on
