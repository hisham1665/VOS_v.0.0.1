# ---------------------------------------------------------------------
# Credentials. Copy to .env and fill in. .env is git-ignored.
# ---------------------------------------------------------------------

# Hugging Face token -- required for hosted model inference.
# Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Groq -- fast hosted LLM for planning and report synthesis.
# Optional: without it, text generation falls back to Hugging Face.
GROQ_API_KEY=

# ---------------------------------------------------------------------
# Model selection (all optional -- defaults shown)
# ---------------------------------------------------------------------
# MAOS_REPORT_VLM=google/medgemma-4b-it
# MAOS_REPORT_VLM_FALLBACK=Qwen/Qwen2.5-VL-7B-Instruct
# MAOS_MODALITY_CLIP=flaviagiammarino/pubmed-clip-vit-base-patch32
# MAOS_NONMEDICAL_CLIP=openai/clip-vit-base-patch32
# Screening cascade models live in capabilities/model_zoo.py.
# MAOS_CXR_CLASSIFIER=...        # replaces the chest X-ray stage-1 screener only
# MAOS_MODEL_ZOO=./my_zoo.json   # add / replace / disable zoo entries
# MAOS_TEXT_LLM=openai/gpt-oss-120b

# ---------------------------------------------------------------------
# Vision routing: auto | ollama | hf | local
# ---------------------------------------------------------------------
# MAOS_VLM_BACKEND=auto
# MAOS_OLLAMA_URL=http://localhost:11434/v1
# MAOS_OLLAMA_MODEL=medgemma1.5:latest

# ---------------------------------------------------------------------
# Performance
# ---------------------------------------------------------------------
# MAOS_BACKEND=auto           # auto | local | remote
# MAOS_DEVICE=auto            # auto | cuda | cpu
# MAOS_FP16=1
# MAOS_MAX_WORKERS=8          # global concurrent node ceiling
# MAOS_MAX_GPU_WORKERS=1      # concurrent local GPU calls (1 for <=6GB VRAM)
# MAOS_BATCH_SIZE=8
# MAOS_MAX_RESIDENT_MODELS=4  # local classifiers kept in memory (LRU evicted)
# MAOS_MAX_IMAGE_EDGE=896     # longest edge before inference
# MAOS_MAX_IMAGES=0           # 0 = all images; positive value samples large series
# MAOS_MAX_FILE_MB=100         # per-input file safety limit
# MAOS_MAX_DOCUMENT_PAGES=200
# MAOS_MAX_DOCUMENT_CHARS=2000000
# MAOS_DOCUMENT_CHUNK_CHARS=8000
# MAOS_DOCUMENT_IMAGE_EDGE=1800
# MAOS_CALL_TIMEOUT=180
# MAOS_MAX_RETRIES=3
# MAOS_CACHE=1
# MAOS_DEIDENTIFY=1           # strip DICOM PHI tags on ingest
# MAOS_LOG_LEVEL=INFO
