    {
      "question_id": "Q4",
      "text": "Distinguish circuit switching from packet switching.",
      "max_marks": 4,
      "question_type": "short_answer",
      "answer_key": {
        "reference_answers": [
          "Circuit switching establishes a dedicated path end to end for the whole call duration and reserves bandwidth; packet switching sends data in independently routed packets that share links on demand."
        ],
        "expected_concepts": [
          "circuit switching",
          "packet switching",
          "connection establishment",
          "store and forward"
        ],
        "accepted_alternatives": ["virtual circuit", "connectionless datagram"],
        "keywords": ["dedicated path", "bandwidth reservation", "statistical multiplexing"],
        "concept_relationships": [
          {
            "source": "packet switching",
            "relationship": "implies",
            "target": "store and forward",
            "weight": 1.0,
            "description": "routing each packet independently is a form of store-and-forward"
          },
          {
            "source": "circuit switching",
            "relationship": "requires",
            "target": "connection establishment",
            "weight": 1.0
          }
        ]
      },
      "rubric": {
        "criteria": [
          { "criterion": "definition", "marks": 1.5, "description": "correct definition of both techniques" },
          { "criterion": "connection_establishment", "marks": 1.5, "description": "explains the resource-reservation difference" },
          { "criterion": "comparison", "marks": 1, "description": "identifies a valid efficiency/trade-off point" }
        ]
      },
      "partial_credit_rules": [
        { "criterion": "definition", "fraction": 0.5, "description": "defines only one of the two techniques" },
        { "criterion": "comparison", "fraction": 0.5, "description": "comparison stated without justification" }
      ]
    },
    {
      "question_id": "Q5",
      "text": "Explain deadlock in operating systems. State the four necessary conditions and outline one prevention strategy.",
      "max_marks": 10,
      "question_type": "long_answer",
      "answer_key": {
        "reference_answers": [
          "Deadlock is a state where a set of processes are blocked because each holds a resource and waits for another resource held by another process in the set. The four necessary conditions are mutual exclusion, hold and wait, no preemption, and circular wait. Prevention breaks one condition, e.g. requesting all resources up front removes hold and wait."
        ],
        "expected_concepts": [
          "definition",
          "mutual exclusion",
          "hold and wait",
          "no preemption",
          "circular wait",
          "deadlock prevention"
        ],
        "accepted_alternatives": ["resource holding", "non-preemptive scheduling"],
        "keywords": ["blocked", "resource", "waits-for cycle"],
        "concept_relationships": [
          {
            "source": "hold and wait",
            "relationship": "alternative",
            "target": "resource holding",
            "weight": 1.0,
            "description": "'resource holding' is accepted terminology for the same condition"
          },
          {
            "source": "circular wait",
            "relationship": "requires",
            "target": "mutual exclusion",
            "weight": 1.0,
            "description": "a genuine circular wait presupposes non-sharable resources"
          },
          {
            "source": "deadlock prevention",
            "relationship": "requires",
            "target": "hold and wait",
            "weight": 1.0,
            "description": "prevention is credited only if the student breaks one named condition"
          }
        ]
      },
      "rubric": {
        "criteria": [
          { "criterion": "definition", "marks": 2, "description": "accurate definition with a wait/blocked picture" },
          { "criterion": "mutual_exclusion", "marks": 2, "description": "non-sharable resource condition stated" },
          { "criterion": "hold_and_wait", "marks": 2, "description": "holding while requesting condition stated" },
          { "criterion": "no_preemption", "marks": 2, "description": "no forced release condition stated" },
          { "criterion": "circular_wait", "marks": 2, "description": "cycle condition stated" }
        ]
      },
      "partial_credit_rules": [
        { "criterion": "definition", "fraction": 0.5, "description": "deadlock described but not precisely" }
      ],
      "special_rules": "Only a full set of all four conditions earns the circular_wait criterion; partial credit applies to definition."
    },
    {
      "question_id": "Q6",
      "text": "A store-and-forward network has N switches between sender and receiver, link bandwidth R bps, and a packet length L bits (ignore propagation). Compute the minimum transfer time for one packet.",
      "max_marks": 5,
      "question_type": "numerical",
      "answer_key": {
        "reference_answers": ["T = (N + 1) * L / R"],
        "expected_concepts": ["store and forward delay", "per-hop transmission delay", "hop count"],
        "accepted_alternatives": ["T = L/R per hop", "transmission delay formula"],
        "keywords": ["N hops", "cumulative delay"],
        "concept_relationships": [
          {
            "source": "per-hop transmission delay",
            "relationship": "requires",
            "target": "store and forward delay",
            "weight": 1.0
          }
        ]
      },
      "rubric": {
        "criteria": [
          { "criterion": "formula", "marks": 2, "description": "correct closed-form expression" },
          { "criterion": "substitution", "marks": 2, "description": "substitutes N, L, R consistently" },
          { "criterion": "final_value", "marks": 1, "description": "numeric/simplified final answer" }
        ]
      }
    },
    {
      "question_id": "Q7",
      "text": "Derive the effective throughput of a stop-and-wait sender given propagation delay RTT and frame size L.",
      "max_marks": 6,
      "question_type": "mathematical",
      "answer_key": {
        "reference_answers": [
          "Throughput = L / (L/R + RTT) when transmission time of ACK is negligible."
        ],
        "expected_concepts": ["transmission time", "round-trip time", "throughput as frames per cycle"],
        "accepted_alternatives": ["L/(RTT + L/R)", "utilization formula"],
        "keywords": ["idle waiting", "ACK delay"],
        "concept_relationships": [
          {
            "source": "throughput as frames per cycle",
            "relationship": "requires",
            "target": "round-trip time",
            "weight": 1.0
          }
        ]
      },
      "rubric": {
        "criteria": [
          { "criterion": "setup", "marks": 2, "description": "identifies the per-frame cycle time" },
          { "criterion": "derivation", "marks": 3, "description": "algebraic derivation is correct" },
          { "criterion": "conclusion", "marks": 1, "description": "final throughput expression stated" }
        ]
      },
      "special_rules": "Ascribing throughput = L/RTT without derivation earns at most half the derivation marks."
    },
