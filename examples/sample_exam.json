    {
      "question_id": "Q10",
      "text": "Write pseudocode for a sliding-window sender that transmits up to W frames before waiting for an ACK. Show the window update step.",
      "max_marks": 8,
      "question_type": "programming",
      "answer_key": {
        "reference_answers": [
          "sendable = min(next_frame + W - 1, last_frame); for f in next_frame..sendable: transmit(f); on ACK(n): next_frame = n + 1."
        ],
        "expected_concepts": ["window bounds", "ACK advancement", "out-of-order buffering"],
        "accepted_alternatives": ["Go-Back-N sender loop", "selective repeat window logic"],
        "keywords": ["cumulative ACK", "pipeline", "W frames"],
        "concept_relationships": [
          {
            "source": "window bounds",
            "relationship": "requires",
            "target": "ACK advancement",
            "weight": 1.0,
            "description": "the sender loop only terminates when ACKs advance the window"
          }
        ]
      },
      "rubric": {
        "criteria": [
          { "criterion": "loop", "marks": 3, "description": "sender loop transmits within window" },
          { "criterion": "ack_update", "marks": 3, "description": "window slides on ACK correctly" },
          { "criterion": "pseudocode", "marks": 2, "description": "clear, executable-by-humans pseudocode" }
        ]
      },
      "special_rules": "A correct but non-executable description earns at most the loop and ack_update criteria."
